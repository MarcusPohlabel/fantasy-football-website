# Copy this file to .env.local and fill in values from your EXISTING Supabase
# project (Project Settings > API) — the one containing the
# "2021 Fantasy football data" table. Never commit .env.local — it's already
# gitignored.
#
# Until these are set (or if the table/query is unreachable), the site
# automatically falls back to the bundled sample dataset in
# src/data/players.json, so it stays fully functional during development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
